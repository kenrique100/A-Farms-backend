# Keycloak + Postgres
KEYCLOAK_DB_NAME=
KEYCLOAK_DB_USER=
KEYCLOAK_DB_PASSWORD=

KEYCLOAK_ADMIN_USER=
KEYCLOAK_ADMIN_PASSWORD=

# Gateway JWT issuer (inside Docker network)
GATEWAY_JWT_ISSUER_URI=http://keycloak:8080/realms/

# Application
spring.application.name=api-gateway

# Server
server.port=${SERVER_PORT:8080}

# Security OAuth2 Resource Server JWT
spring.security.oauth2.resourceserver.jwt.issuer-uri=${KEYCLOAK_ISSUER_URI:http://localhost:8180/realms/afarms-realm}

# Management Endpoints
management.endpoints.web.exposure.include=health,info

# Gateway security
JWT_SECRET=CHANGE_THIS_JWT_SECRET
ADMIN_KEY=CHANGE_THIS_ADMIN_KEY

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Routes
INCOME_SERVICE_URL=http://income-service:8080
EXPENSE_SERVICE_URL=http://expense-service:8080
INVESTMENT_SERVICE_URL=http://investment-service:8080
TRANSACTION_SERVICE_URL=http://transaction-service:8080
USER_SERVICE_URL=http://user-service:8085

# Runtime
SPRING_PROFILES_ACTIVE=docker
LOG_LEVEL=INFO

# SpringDoc OpenAPI
springdoc.api-docs.enabled=${SPRINGDOC_API_DOCS_ENABLED:true}
springdoc.api-docs.path=${SPRINGDOC_API_DOCS_PATH:/v3/api-docs}
springdoc.swagger-ui.enabled=${SPRINGDOC_SWAGGER_UI_ENABLED:true}
springdoc.swagger-ui.path=${SPRINGDOC_SWAGGER_UI_PATH:/swagger-ui.html}
